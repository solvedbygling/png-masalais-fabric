        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "•  Real money is never dropped. Lines with problems stay in every total and are flagged for finance.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#2F2F2F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Only records that are not real are removed, such as the same journal exported twice.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#2F2F2F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Fixable errors are corrected and logged with the original value, such as fund codes typed in different ways.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#2F2F2F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Attendance that can't be linked to a registered person is set aside, so reach isn't overstated.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#2F2F2F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
    },
